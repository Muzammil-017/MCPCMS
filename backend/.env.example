# ── Required ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/mcpcms
JWT_SECRET=replace_with_a_long_random_string
PORT=5000
NODE_ENV=development

# Your private Super Admin login, created on first start only. Never share or commit real values.
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=you@example.com
SEED_SUPER_ADMIN_PASSWORD=change_this_password
# Set to true for one start to reset the Super Admin back to the SEED_ values above (account recovery)
# SEED_SUPER_ADMIN_RESET=false

# ── Production ──────────────────────────────────────────────
# Frontend address used in password reset links
FRONTEND_URL=http://localhost:3000
# Comma-separated allowed frontend URLs (leave unset for local dev)
# CORS_ORIGIN=https://your-app.vercel.app

# ── Email (optional) ────────────────────────────────────────
# Gmail address + app password, used for "Forgot password" and the contact form
# EMAIL_USER=your_gmail_address
# EMAIL_PASS=your_gmail_app_password
# Local development without SMTP: print emails (incl. reset links) to the server console instead
# EMAIL_DEV_LOG=true

# ── Demo company (optional) ─────────────────────────────────
# Password for the demo accounts created by `npm run seed:demo` (default Demo@1234)
# DEMO_PASSWORD=Demo@1234

# ── Legacy (optional) ───────────────────────────────────────
# Only needed to open reimbursement bills uploaded before bills moved into MongoDB
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SUPABASE_REIMBURSEMENT_BUCKET=reimbursement-bills
